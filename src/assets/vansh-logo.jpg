<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#14213d" />
      <stop offset="50%" stop-color="#0b1329" />
      <stop offset="100%" stop-color="#050a14" />
    </linearGradient>

    <!-- Metallic Gold Gradients -->
    <linearGradient id="goldPrimary" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCE0AD" />
      <stop offset="30%" stop-color="#DFAC42" />
      <stop offset="70%" stop-color="#C58C1B" />
      <stop offset="100%" stop-color="#996515" />
    </linearGradient>

    <linearGradient id="goldLight" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#DFAC42" />
      <stop offset="45%" stop-color="#FFF3D1" />
      <stop offset="70%" stop-color="#E2B357" />
      <stop offset="100%" stop-color="#996515" />
    </linearGradient>

    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#996515" />
      <stop offset="50%" stop-color="#FCE0AD" />
      <stop offset="100%" stop-color="#DFAC42" />
    </linearGradient>

    <!-- Glow Filter -->
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Circle -->
  <circle cx="256" cy="256" r="250" fill="url(#bgGrad)" stroke="url(#goldPrimary)" stroke-width="4" />
  <circle cx="256" cy="256" r="236" fill="none" stroke="url(#goldAccent)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.6" />
  <circle cx="256" cy="256" r="226" fill="none" stroke="url(#goldLight)" stroke-width="1" opacity="0.4" />

  <!-- Geometric Avenue / Growth Background Lines -->
  <g opacity="0.15" stroke="url(#goldLight)" stroke-width="1.5">
    <line x1="256" y1="90" x2="120" y2="400" />
    <line x1="256" y1="90" x2="160" y2="400" />
    <line x1="256" y1="90" x2="200" y2="400" />
    <line x1="256" y1="90" x2="256" y2="400" />
    <line x1="256" y1="90" x2="312" y2="400" />
    <line x1="256" y1="90" x2="352" y2="400" />
    <line x1="256" y1="90" x2="392" y2="400" />
  </g>

  <!-- Security Shield & Crest Outline -->
  <path d="M 256 70 
           Q 340 70 380 115 
           C 380 230 330 335 256 385 
           C 182 335 132 230 132 115 
           Q 172 70 256 70 Z"
        fill="none" 
        stroke="url(#goldPrimary)" 
        stroke-width="3.5" 
        opacity="0.8" />

  <!-- Central Crest: Stylized 'V' Monogram + Shield + Avenue Perspective -->
  <!-- Left Wing of V -->
  <path d="M 170 145 
           L 218 145 
           L 256 295 
           L 232 295 
           Z" 
        fill="url(#goldLight)" 
        filter="url(#softGlow)" />

  <path d="M 170 145 
           L 204 145 
           L 256 348 
           L 242 348 
           Z" 
        fill="url(#goldPrimary)" />

  <!-- Right Wing of V (Ascending higher for growth / wealth trajectory) -->
  <path d="M 342 145 
           L 294 145 
           L 256 295 
           L 280 295 
           Z" 
        fill="url(#goldPrimary)" />

  <path d="M 342 145 
           L 308 145 
           L 256 348 
           L 270 348 
           Z" 
        fill="url(#goldLight)" 
        filter="url(#softGlow)" />

  <!-- Center Ascending Avenue Arrow / Keystone -->
  <polygon points="256,120 274,165 264,165 264,260 248,260 248,165 238,165" 
           fill="url(#goldLight)" />

  <!-- Diamond Star of Excellence at Top Peak -->
  <polygon points="256,92 263,106 277,113 263,120 256,134 249,120 235,113 249,106" 
           fill="url(#goldLight)" 
           filter="url(#softGlow)" />

  <!-- Bottom Brand Text Monogram -->
  <text x="256" y="424" 
        text-anchor="middle" 
        font-family="'Plus Jakarta Sans', 'Segoe UI', sans-serif" 
        font-size="28" 
        font-weight="700" 
        letter-spacing="9" 
        fill="url(#goldLight)">
    VANSH
  </text>

  <text x="256" y="452" 
        text-anchor="middle" 
        font-family="'Plus Jakarta Sans', 'Segoe UI', sans-serif" 
        font-size="14" 
        font-weight="600" 
        letter-spacing="5" 
        fill="#DFAC42" 
        opacity="0.9">
    SECURE AVENUE
  </text>
</svg>
